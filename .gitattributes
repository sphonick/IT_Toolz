* text=auto eol=lf

# Windows scripting hosts are happiest with CRLF; cmd.exe genuinely
# mis-parses some constructs in LF-only files.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.reg text eol=crlf
*.txt text eol=crlf

# Evidence captured from affected machines: preserve byte-for-byte.
# wu-audit.txt and several of the captured scripts/logs are UTF-16LE, where
# git's LF->CRLF rewriting inserts 0x0D before the low byte of a newline and
# corrupts the file. -text disables all conversion.
windows/WindowsUpdateGuard/wu-audit.txt   -text
windows/WindowsUpdateGuard/Scripts/**     -text
